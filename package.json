{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "ecolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint resources/js",
    "format": "prettier --write resources/js",
    "format:check": "prettier --check resources/js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@lucide/vue": "^1.78.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.23",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "packageManager": "pnpm@11.25.0"
}
