{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "APP_ENV": "local"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(php artisan:*)",
      "Bash(php -v)",
      "Bash(composer install:*)",
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer show:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx shadcn-vue@latest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore --staged:*)",
      "Bash(git push origin dev)",
      "Bash(git push -u origin dev)",
      "Bash(ls:*)",
      "Bash(mkdir:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(rm:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./backend/.env)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./frontend/pnpm-lock.yaml)",
      "Edit(./backend/composer.lock)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)"
    ]
  }
}
